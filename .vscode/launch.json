{
  // F5 в VS Code. Отладчик cppvsdbg из расширения C/C++ — родной для сборок MSVC.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Приложение KVT (отладка Rust + UI)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/kvt.exe",
      "cwd": "${workspaceFolder}/app/src-tauri",
      // Отладочная сборка грузит UI с Vite (localhost:5173), поэтому он запускается первым.
      "preLaunchTask": "Отладка: UI + сборка приложения",
      "console": "integratedTerminal"
    },
    {
      "name": "Служба KVT в консоли",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/kvt-service.exe",
      "args": ["--console"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Rust: сборка службы",
      "console": "integratedTerminal",
      "environment": [{ "name": "RUST_LOG", "value": "debug" }]
    }
  ]
}
