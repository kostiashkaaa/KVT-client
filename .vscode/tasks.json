{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "UI: dev-сервер (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/app" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activatesOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "Приложение: tauri dev",
      "detail": "Окно приложения с горячей перезагрузкой UI и пересборкой Rust",
      "type": "shell",
      "command": "npm run tauri dev",
      "options": { "cwd": "${workspaceFolder}/app" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Rust: все тесты",
      "type": "shell",
      "command": "cargo test --workspace",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Rust: clippy",
      "type": "shell",
      "command": "cargo clippy --workspace --all-targets -- -D warnings",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Rust: сборка приложения",
      "type": "shell",
      "command": "cargo build -p kvt-app",
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Rust: сборка службы",
      "type": "shell",
      "command": "cargo build -p kvt-service",
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Отладка: UI + сборка приложения",
      "dependsOn": ["UI: dev-сервер (Vite)", "Rust: сборка приложения"]
    },
    {
      "label": "UI: проверка типов",
      "type": "shell",
      "command": "npm run check",
      "options": { "cwd": "${workspaceFolder}/app" },
      "problemMatcher": []
    }
  ]
}
